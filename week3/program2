#include<iostream>
using namespace std;
int main()
{
    int i,n,key,a[10],count=0;
    cout<<"enter n& key";
    cin>>n>>key;
    cout<<"enter array elements"
    for(i=0;i<n;i++)
    {
        cin>>a[i];
        if(a[i]==key)
        {
            count++;
        }
    }
    if(count==0)
    {
        cout<<key<<"not found";
    }
    else
    {
        cout<<"key repeated for"<<count<<"times";
    }
}
